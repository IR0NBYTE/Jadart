# build + analysis artifacts. The two arm64 fixtures under flubench/artifacts are
# committed on purpose (the suite runs on them with no Flutter install); everything else
# that a build drops there is not.
flubench/artifacts/symbols/
**/build/
**/.gradle/
**/.dart_tool/
*.apk
*.so
!flubench/artifacts/*/lib/arm64-v8a/libapp.so
!challenges/*/*.apk
*.unflutter/
__pycache__/
*.pyc

# python packaging output. jadart.egg-info was committed once by accident: it is
# regenerated by every `pip install ./framework`, so it shows up as a spurious diff on
# any machine that has built the package.
*.egg-info/
dist/
.venv/
venv/
.pytest_cache/

# vendored third-party trees (clone separately; see README)
unflutter/
blutter/

# IDE + OS cruft
.idea/
*.iml
.DS_Store

# dev-time SDK source cache (tools/sdk_source.py)
framework/.sdkcache/

# multi-version corpus binaries (regenerate: framework/tools/build_corpus.py). Both
# spellings: the trailing slash does not match a SYMLINK of that name, which is how a
# checkout that borrows another one's corpus ends up committing the link.
flubench/corpus
flubench/corpus/

# An unpacked APK, or a decompiler's output, sitting next to the challenge it came from.
# `git add -A` swept 632 of these in once: the whole unzipped container plus a jadx run,
# every file of which carried the absolute path it was decompiled from. Only the four
# files the challenge actually ships belong here.
challenges/*/classes/
challenges/*/classes.dex
challenges/*/assets/
challenges/*/res/
challenges/*/lib/
challenges/*/META-INF/
challenges/*/kotlin/
challenges/*/AndroidManifest.xml
challenges/*/resources.arsc
challenges/*/*.bin
challenges/*/*.json
challenges/*/solve.py
challenges/*/build/
